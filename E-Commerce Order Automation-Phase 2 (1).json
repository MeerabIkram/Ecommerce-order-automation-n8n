    {
      "parameters": {
        "jsCode": "const order = $('Create Order').first().json;\nconst products = $input.all().map(i => i.json);\n\nconst orderId = 'O' + Date.now();\n\nconst items = order.items.map(it => {\n  const p = products.find(x => x['Product ID'] === it.productId);\n\n  if (!p) {\n    throw new Error(`Product ${it.productId} not found`);\n  }\n\n  const price = Number(String(p['Price']).replace(/[^0-9.]/g, ''));\n\n  return {\n    'Order ID': orderId,\n    'Product ID': it.productId,\n    'Quantity': it.quantity,\n    'Price': price,\n    lineTotal: price * it.quantity\n  };\n});\n\nconst total = items.reduce((sum, item) => sum + item.lineTotal, 0);\n\nreturn [{\n  json: {\n    'Order ID': orderId,\n    'Customer ID': order.customerId,\n    'Order Date': new Date().toISOString().slice(0, 10),\n    'Total Amount': Number(total.toFixed(2)),\n    'Payment Status': 'Pending',\n    'Order Status': 'New',\n    'Fulfillment Status': 'Unfulfilled',\n    items\n  }\n}];"
      },

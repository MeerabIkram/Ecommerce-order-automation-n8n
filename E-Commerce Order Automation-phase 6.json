    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst orders = $('Orders').all();\nconst customers = $('Find Customer').all();\n\nconst grouped = {};\n\nfor (const item of items) {\n  const data = item.json;\n  const orderId = data[\"Order ID\"];\n\n  if (!grouped[orderId]) {\n    const order = orders.find(o => o.json[\"Order ID\"] === orderId);\n    const customerId = order?.json[\"Customer ID\"];\n\n    const customer = customers.find(\n      c => c.json[\"Customer ID\"] === customerId\n    );\n\n    grouped[orderId] = {\n      orderId,\n      customerName: customer?.json[\"Name\"] || \"\",\n      address: customer?.json[\"Address\"] || \"\",\n      products: [],\n      quantities: []\n    };\n  }\n\n  grouped[orderId].products.push(data[\"Product ID\"]);\n  grouped[orderId].quantities.push(data[\"Quantity\"]);\n}\n\nreturn Object.values(grouped).map(order => ({\n  json: {\n    \"Order ID\": order.orderId,\n    \"Customer Name\": order.customerName,\n    \"Products\": order.products.join(\", \"),\n    \"Quantity\": order.quantities.join(\", \"),\n    \"Address\": order.address\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
